# EARIP Environment Configuration Template
PROJECT_NAME="EARIP — Enterprise AI Retail Intelligence Platform"
VERSION="2.0.0"

# Groq AI Key (High-speed Llama-3.3-70b AI Business Analyst)
GROQ_API_KEY="your-groq-api-key-here"

# Supabase Configuration
# Enter your Supabase Project URL and anon/service key
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"
SUPABASE_DB_URL="postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres"

# Data Paths
DATASET_PATH="data/online_retail_II.xlsx"
ANALYTICS_CACHE_PATH="data/processed_analytics.json"
SQLITE_DB_PATH="data/earip.db"
